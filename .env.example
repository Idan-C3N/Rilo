# Copy to .env and fill in. Secrets + per-machine values only.
# Under Docker Compose, DB_PATH / WEB_PORT / SEARXNG_URL are set by compose.yml
# (and override anything here) — you only need them for native `npm` runs.

# --- Required ---
ENC_KEY=            # base64 of 32 random bytes: openssl rand -base64 32
TELEGRAM_TOKEN=
DB_PATH=./data/agent.db   # native runs only; compose sets /app/data/agent.db

# --- Optional core ---
OPENROUTER_KEY=     # optional global fallback; per-user keys preferred
OWNER_TELEGRAM_ID=  # your Telegram numeric user id. Required for approvals to work:
                    # this user is auto-allowlisted + made owner on boot, receives
                    # access-request pings, and can /approve|/deny (or use the web
                    # Pending list). Unset = nobody can approve new registrations.
WEB_PORT=8080       # native runs only; compose always uses 8080 internally
WEB_BASE_URL=       # optional; defaults to http://localhost:$WEB_PORT
HEARTBEAT_DEFAULT_MIN=30
DEFAULT_MODEL_FAMILY=  # optional; provider prefix seeding a new user's model defaults (default: anthropic/)

# --- Web search backend ---
# Docker: bundled SearXNG is wired automatically (no signup, no cost) — leave this alone.
# Native: SearXNG isn't running, so set a reachable backend below.
# SEARXNG_URL=http://searxng:8080
# Opt in to Google Programmable Search instead (set BOTH):
# GOOGLE_SEARCH_KEY=
# GOOGLE_SEARCH_CX=
# Force a specific backend for comparison (searxng|google|tavily); overrides the above:
# SEARCH_BACKEND=
# Tavily is demoted — reachable only via SEARCH_BACKEND=tavily:
# TAVILY_API_KEY=

# --- Logging ---
# pino level: fatal|error|warn|info|debug|trace (default: info). `debug` adds
# message content + full turn context; `info` logs lengths/metadata only.
# LOG_LEVEL=info

# --- Semantic memory (embeddings) ---
# Docker: the bundled `embed` container is wired automatically — leave this alone.
# Native (npm) runs have no embed server, so recall falls back to substring match.
# Point at your own TEI server to enable semantic recall natively:
# EMBED_URL=http://localhost:8081

# --- Google Workspace (Gmail + Calendar), optional ---
GOOGLE_CLIENT_ID=      # from a Google Cloud OAuth client
GOOGLE_CLIENT_SECRET=  # Desktop type for the loopback/paste flow; Web type if ENABLE_WEB_OAUTH=true
ENABLE_WEB_OAUTH=      # optional: 'true' offers one-click "Connect with Google" instead of paste.
                       # Requires a public HTTPS WEB_BASE_URL and a Google Cloud OAuth client of type
                       # "Web application" with $WEB_BASE_URL/oauth/google/callback as an authorized
                       # redirect URI. Leave unset (default false) for firewalled installs — the
                       # loopback/paste flow (scripts/google-auth.ts) is used instead.

# --- Public HTTPS (Caddy overlay), optional ---
# Only for the public deploy path (compose.caddy.yml). Leave unset for firewalled installs.
DOMAIN=          # your domain, e.g. agent.example.com — Caddy issues a Let's Encrypt cert for it
