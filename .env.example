DB_PATH=./data/agent.db
ENC_KEY=            # base64 of 32 random bytes: openssl rand -base64 32
TELEGRAM_TOKEN=
OPENROUTER_KEY=     # optional global fallback; per-user keys preferred
WEB_PORT=8080
WEB_BASE_URL=        # optional; defaults to http://localhost:$WEB_PORT
HEARTBEAT_DEFAULT_MIN=30
TAVILY_API_KEY=     # optional: enables web search (free tier at tavily.com)
GOOGLE_CLIENT_ID=      # optional: enables Google Workspace (Gmail+Calendar)
GOOGLE_CLIENT_SECRET=  # from Google Cloud OAuth client (Desktop type)
DEFAULT_MODEL_FAMILY=  # optional; provider prefix used to seed a new user's model defaults from the live OpenRouter catalog (default: anthropic/)
